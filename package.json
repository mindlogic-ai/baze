    "dist/**/*",
    "README.md",
    "AGENT_MANUAL.md"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.2.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "rm -rf .build && tsc -p tsconfig.test.json && node scripts/run-tests.mjs"
  }
