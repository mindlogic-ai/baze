{
  "name": "@mindlogic-ai/baze",
  "version": "0.1.0",
  "description": "Run Claude Code, Codex and OpenCode through the FactChat gateway; read models, credits and usage from a shell.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
